DOMAIN=http://localhost:4000
PUBLIC_ORIGIN=http://localhost:5173
ORIGIN_ALLOWLIST=http://localhost:4000,http://localhost:5173
PORT=4000
DATABASE_URL=file:../database/modoverlay.db
SESSION_SECRET=replace-with-a-long-random-secret
UPLOAD_DIR=uploads
MAX_IMAGE_SIZE=10485760
MAX_GIF_SIZE=20971520
MAX_VIDEO_SIZE=104857600
MAX_AUDIO_SIZE=52428800
MAX_TOTAL_UPLOAD_SIZE=5368709120
MIN_FREE_DISK_BYTES=536870912
NODE_ENV=development
INITIAL_ADMIN_USERNAME=owner
INITIAL_ADMIN_PASSWORD=change-me-now
TWITCH_CLIENT_ID=fill-in-your-twitch-client-id-on-a-twitch-developer-console
TWITCH_CLIENT_SECRET=fill-in-your-twitch-secret-on-a-twitch-developer-console
# Exact registered callback URL. For Vite development use http://localhost:5173/api/auth/twitch/callback
TWITCH_OAUTH_REDIRECT_URI=http://localhost:5173/api/auth/twitch/callback
# Stable 32-byte key encoded as 64 hex characters; generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
OAUTH_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
TTS_ENABLED=false
TTS_PYTHON=/opt/tts-test/.venv/bin/python
TTS_DEBUG=0
