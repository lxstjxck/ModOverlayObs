{
  "name": "mod-overlay-obs",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted moderator overlay for OBS Browser Source.",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"tsx watch src/server/server.ts\" \"vite --host 0.0.0.0\"",
    "dev:server": "tsx watch src/server/server.ts",
    "dev:client": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/server.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "lint": "eslint src tests --max-warnings=0",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:prepare": "node -e \"const fs=require('fs'); fs.mkdirSync('database',{recursive:true}); fs.closeSync(fs.openSync('database/modoverlay.db','a'));\"",
    "db:push": "npm run db:prepare && prisma db push",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^3.0.2",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lucide-react": "^0.544.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.4.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "prisma": "6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5",
    "vitest": "5.0.0"
  }
}
